# Used by `docker compose --profile prod` (copy to .env and edit).
# Backend-only settings for running without Docker: backend/.env.example
# Frontend settings: frontend/.env.example

# Postgres for the prod profile. CHANGE THE PASSWORD.
POSTGRES_USER=monsoon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=monsoon

# Host port for the app (nginx serves the UI and proxies /api).
APP_PORT=8080

# Public URL of the app, used in WhatsApp message links and as the allowed CORS origin.
PUBLIC_APP_URL=http://localhost:8080

# Language for the (not yet implemented) message translation.
NOTIFY_REGIONAL_LANGUAGE=mr
