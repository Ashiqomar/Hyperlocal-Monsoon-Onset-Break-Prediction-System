# Copy to .env (dev) or set in your host's dashboard (e.g. Vercel).

# Where the browser sends API calls.
#   /api (default): same origin; the Vite dev server or nginx forwards to the backend.
#   Vercel: your backend's public URL, e.g. https://monsoon-backend.onrender.com
VITE_API_BASE=/api

# Dev server only: where Vite forwards /api to.
BACKEND_URL=http://localhost:8000
