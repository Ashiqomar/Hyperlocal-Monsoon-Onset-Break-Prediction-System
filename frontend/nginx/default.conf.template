# Rendered at container start by the nginx image: ${BACKEND_URL} is substituted
# from the environment (nginx's own $variables are left alone).
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # API: /api/health -> ${BACKEND_URL}/health (same origin, so no CORS needed).
    location /api/ {
        proxy_pass ${BACKEND_URL}/;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # Hashed build assets never change: cache for a year.
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Client-side routes (/farmer/GP014, /admin/feedback) fall back to the app shell.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
