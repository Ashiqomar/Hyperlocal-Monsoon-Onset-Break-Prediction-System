# Backend settings for running without Docker (copy to backend/.env).
# Local dev defaults to SQLite. To use Postgres, set e.g.:
# DATABASE_URL=postgresql+psycopg://monsoon:monsoon@localhost:5432/monsoon
DATABASE_URL=sqlite:///./monsoon.db
# Allowed browser origins: comma-separated or a JSON list.
CORS_ORIGINS=http://localhost:5173
# Optional regex for extra origins (e.g. Vercel previews):
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Frontend base URL used in links inside outgoing messages
PUBLIC_APP_URL=http://localhost:5173

# Notifications (not wired yet: /notify only logs messages)
NOTIFY_REGIONAL_LANGUAGE=mr
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
